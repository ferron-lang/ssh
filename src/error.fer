// `ssh.error`: `SshError`, the failure every fallible call returns.

use std.actor.{ActorError, ActorErrorKind}
use std.error.Error
use std.test.TestContext

/// Why an SSH operation failed.
#[derive(Eq, Hash, Variants)]
pub type SshErrorKind =
  /// The server's own host key could not be generated, written, or loaded.
  | HostKey
  /// The address could not be bound or listened on.
  | Listen
  /// The connection is closed.
  | Closed
  /// A `ClientConfig` or an argument is not usable; nothing was sent.
  | Config
  /// The server could not be reached, or the key exchange with it failed.
  | Connect
  /// A step took longer than its timeout.
  | Timeout
  /// The server's host key is not recorded, and the policy records none.
  | HostKeyUnknown
  /// The server's host key is not the one recorded or pinned for it:
  /// another server answers, or its key was replaced.
  | HostKeyChanged
  /// The `known_hosts` file could not be read or written.
  | KnownHosts
  /// No authentication method let the client in.
  | Authentication
  /// The server refused a channel or a request on it (a command, a
  /// terminal, a shell).
  | Channel
  /// A command wrote more than the caller allowed.
  | TooLarge
  /// The actor runtime failed (a closed channel, a cancelled scope).
  | Actor

/// A failed SSH operation: its kind, libssh's or this package's message,
/// and the error that caused it when there is one (an `ActorError` for
/// `Actor`), which `source()` and `AnyError.downcast` find. Compare errors
/// by `kind`.
// shortcut: no `Eq`, against conventions 3.4, because `ActorError` has
// none and a struct holding it cannot derive it; add `Eq` when
// `ActorError` gets it.
#[derive(Error)]
#[error("{kind}: {message}")]
pub struct SshError {
  pub kind: SshErrorKind,
  pub message: String,
  #[source]
  pub cause: Option[ActorError],
}

impl FromError[ActorError] for SshError {
  fn from_error(error: ActorError) -> SshError {
    return SshError { kind: SshErrorKind.Actor, message: "{error}", cause: Some(error) }
  }
}

pub(pkg) fn failure(kind: SshErrorKind, message: String) -> SshError {
  return SshError { kind: kind, message: message, cause: None }
}

#[test("an error displays its kind and message")]
fn error_displays_kind_and_message() -> Unit {
  expect.equal("{failure(SshErrorKind.Listen, "address in use")}", "Listen: address in use")
  expect.equal(SshErrorKind.from_name("HostKeyChanged"), Some(SshErrorKind.HostKeyChanged))
  expect.equal(SshErrorKind.variants().len(), 13)
}

#[test("an actor failure keeps the ActorError as its source")]
fn actor_errors_convert(context: TestContext) -> Unit {
  let made: Result[Channel[Int], ActorError] = context.actors.channel(capacity: 1)
  let closed = made.expect_ok("a channel")
  closed.sender.close().expect_ok("the channel closes")
  let actor_error = closed.receiver.receive().expect_err("a closed channel fails")
  expect.equal(actor_error.kind(), ActorErrorKind.Closed)
  let error = SshError.from_error(actor_error)
  expect.equal(error.kind, SshErrorKind.Actor)
  expect.equal(error.cause.map(|cause| cause.kind()), Some(ActorErrorKind.Closed))
  expect.is_some(error.source())
  expect.is_true("{error}".starts_with("Actor: "))
}
